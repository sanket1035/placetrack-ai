DATABASE_URL="postgresql://placetrack:placetrack@localhost:5432/placetrack?schema=public"
JWT_SECRET="replace-me-in-production"
PORT=4000
NEXT_PUBLIC_API_URL="http://localhost:4000"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Nodemailer SMTP Configuration
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="PlaceTrack AI <no-reply@placetrack.ai>"

# ── Authentication (Google sign-in only) ───────────────────────────────────────
# OAuth 2.0 Web client ID from Google Cloud Console (authorised JS origin = your frontend URL)
GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
# Comma-separated emails that become ADMIN on first Google sign-in
ADMIN_EMAILS=""
# Comma-separated college email domains whose students may self-register, e.g. "kkwagh.edu.in"
ALLOWED_STUDENT_EMAIL_DOMAINS=""
# Frontend origin allowed by CORS in production
FRONTEND_URL="http://localhost:3000"
# Set to true only for demo databases: seeds fake students when the database is empty
AUTO_SEED="false"
