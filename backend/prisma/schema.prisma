generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  STUDENT
  TPC // Training & Placement Coordinator (scoped to one department)
  ADMIN
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  APTITUDE_CLEARED
  TECHNICAL_ROUND
  HR_ROUND
  SELECTED
  REJECTED
}

enum DriveStatus {
  DRAFT
  OPEN
  CLOSED
  COMPLETED
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  name          String?
  avatarUrl     String?
  googleId      String?       @unique
  lastLoginAt   DateTime?
  role          UserRole
  student       Student?
  coordinator   Coordinator?
  notifications Notification[]
  activityLogs  ActivityLog[]
  resumeAnalyses ResumeAnalysis[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Student {
  id              String        @id @default(cuid())
  userId          String        @unique
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  cgpa            Float
  branch          String
  backlogs        Int           @default(0)
  graduationYear  Int
  skills          String[]
  resumeUrl       String?
  readinessScore  Float         @default(0)
  mockTestCount   Int           @default(0)
  phone           String?
  linkedinUrl     String?
  projectsCount   Int           @default(0)
  internshipsCount Int          @default(0)
  emailEnabled    Boolean       @default(true)
  onboarded       Boolean       @default(false)
  applications    Application[]
  offCampus       OffCampusApplication[]
  testResults     TestResult[]

  @@index([branch, graduationYear])
  @@index([readinessScore])
}

/// Training & Placement Coordinator profile. `department` must equal Student.branch for the students they manage.
model Coordinator {
  id          String @id @default(cuid())
  userId      String @unique
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  department  String
  phone       String?
}

model Company {
  id          String           @id @default(cuid())
  name        String           @unique
  logo        String?
  website     String?
  description String?
  drives      PlacementDrive[]
  createdAt   DateTime         @default(now())
}

model PlacementDrive {
  id               String        @id @default(cuid())
  companyId        String
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role             String
  package          Float
  /// Upper end when the company only gives a range (e.g. 3.5-5 LPA). `package` is then the minimum.
  packageMax       Float?
  location         String
  jobType          String
  description      String
  minCgpa          Float
  allowedBranches  String[]
  maxBacklogs      Int
  graduationYear   Int
  deadline         DateTime
  /** College Google Form (or other) link students use to apply; PlaceTrack only tracks the application. */
  applyUrl         String?
  testDate         DateTime?
  interviewDate    DateTime?
  status           DriveStatus   @default(OPEN)
  applications     Application[]
  createdAt        DateTime      @default(now())

  @@index([status, deadline])
  @@index([graduationYear])
}

model Application {
  id          String             @id @default(cuid())
  studentId   String
  driveId     String
  student     Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  drive       PlacementDrive     @relation(fields: [driveId], references: [id], onDelete: Cascade)
  status      ApplicationStatus  @default(APPLIED)
  timeline    Json
  interview   Interview?
  appliedAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([studentId, driveId])
  @@index([status])
  @@index([driveId, status])
}

model Interview {
  id              String      @id @default(cuid())
  applicationId   String      @unique
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  dateTime        DateTime
  mode            String
  locationOrLink  String
  status          String
  feedback        String?
}

model AptitudeTest {
  id             String       @id @default(cuid())
  title          String
  duration       Int
  sectionConfig  Json
  questions      Question[]
  results        TestResult[]
  createdAt      DateTime     @default(now())
}

model Question {
  id             String       @id @default(cuid())
  testId         String
  test           AptitudeTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  section        String
  questionText   String
  options        String[]
  correctAnswer  Int
  explanation    String
}

model TestResult {
  id             String       @id @default(cuid())
  studentId      String
  testId         String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  test           AptitudeTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  score          Float
  sectionScores  Json
  accuracy       Float
  strongAreas    String[]
  weakAreas      String[]
  completedAt    DateTime     @default(now())

  @@unique([studentId, testId])
  @@index([completedAt])
}

model Notification {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  message    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  resource   String
  details    Json?
  timestamp  DateTime @default(now())

  @@index([timestamp])
  @@index([resource])
}

model ResumeAnalysis {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName    String?
  score       Float
  skills      String[]
  sections    String[]
  suggestions String[]
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model InterviewQuestion {
  id         String   @id @default(cuid())
  role       String
  question   String
  difficulty String   // EASY, MEDIUM, HARD
  category   String   // Technical, Behavioral, HR
  modelAnswer String?
  createdAt  DateTime @default(now())
  attempts   QuestionAttempt[]
}

model QuestionAttempt {
  id         String   @id @default(cuid())
  questionId String
  userId     String
  answer     String
  score      Int?
  feedback   String?
  createdAt  DateTime @default(now())
  question   InterviewQuestion @relation(fields: [questionId], references: [id])
}

enum OffCampusType {
  JOB
  INTERNSHIP
}

enum OffCampusStatus {
  APPLIED
  ASSESSMENT
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

/// A student's private record of an application made outside the college drives. Only its owner can read or change it.
model OffCampusApplication {
  id          String          @id @default(cuid())
  studentId   String
  student     Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  company     String
  role        String
  type        OffCampusType   @default(JOB)
  link        String?
  location    String?
  compensation String?
  appliedOn   DateTime        @default(now())
  followUpOn  DateTime?
  status      OffCampusStatus @default(APPLIED)
  notes       String?
  timeline    Json
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([studentId, status])
}
