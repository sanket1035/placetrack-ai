# ==============================================================================
# PlaceTrack AI Frontend - Environment Configuration Example
# Copy this file to frontend/.env.local and replace placeholders with your actual settings.
# ==============================================================================

# Public API URL pointing to the Express Backend API (Default: http://localhost:4000)
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Google OAuth "Web application" client id (same value as GOOGLE_CLIENT_ID in the backend)
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# Optional: contact email shown on the landing page
NEXT_PUBLIC_CONTACT_EMAIL=""

# Optional: Google Gemini API key for server-side Next.js route fallback
GEMINI_API_KEY="your-google-gemini-api-key"

# Optional: Gemini model identifier (Default: gemini-1.5-flash)
GEMINI_MODEL="gemini-1.5-flash"
